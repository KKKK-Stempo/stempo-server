// Jenkinsfile.rhythm
def FAILED_STAGE = ""
def vars = [:]

pipeline {
    agent any

    triggers {
        githubPush()
    }

    stages {
        stage('Check Relevant Changes') {
            steps {
                script {
                    def changedFiles = sh(script: "git diff --name-only HEAD~1..HEAD", returnStdout: true).trim().split('\n')
                    def isRelevantChange = changedFiles.any { file ->
                        file.startsWith("stempo-rhythm/") || file.startsWith("cd/")
                    }
                    if (!isRelevantChange) {
                        echo "No changes in stempo-rhythm or cd directories. Skipping pipeline."
                        error("Aborting pipeline because no changes in relevant directories.")
                    }
                }
            }
        }
        stage('Load Environment Variables') {
            steps {
                script { FAILED_STAGE = env.STAGE_NAME }
                withCredentials([file(credentialsId: 'stempo_prod_rhythm_config_yml', variable: 'CONFIG_FILE')]) {
                    script {
                        def envLoader = load 'scripts/common/envLoader.groovy'
                        vars.WORKSPACE = env.WORKSPACE
                        def mappingTable = [
                            [yamlPath: "jenkins-domain", targetKey: "JENKINS_DOMAIN", required: true],
                            [yamlPath: "slack.webhook-url", targetKey: "SLACK_WEBHOOK_URL", required: true],
                            [yamlPath: "slack.color-success", targetKey: "SLACK_COLOR_SUCCESS", required: true],
                            [yamlPath: "slack.color-failure", targetKey: "SLACK_COLOR_FAILURE", required: true],

                            [yamlPath: "dockerhub.repo", targetKey: "DOCKER_HUB_REPO", required: true],

                            [yamlPath: "container.image-name", targetKey: "IMAGE_NAME", required: true],
                            [yamlPath: "containers.container-name", targetKey: "CONTAINER_NAME", required: true],
                            [yamlPath: "containers.app-port", targetKey: "APP_PORT", required: true],

                            [yamlPath: "networks.application", targetKey: "APPLICATION_NETWORK", required: true],
                            [yamlPath: "networks.infra", targetKey: "INFRA_NETWORK", required: true],

                            [yamlPath: "docker.dockerfile-path", targetKey: "DOCKERFILE_PATH", required: true],
                            [yamlPath: "docker.build-context", targetKey: "BUILD_CONTEXT", required: true],

                            [yamlPath: "healthcheck.actuator-path", targetKey: "ACTUATOR_PATH", required: true],
                            // 추가 매핑이 필요하면 여기에...
                        ]
                        envLoader.loadEnvironmentVariables(configFile: env.CONFIG_FILE, targetMap: vars, mappingTable: mappingTable)
                    }
                }
            }
        }
        stage('Concurrent Pre-Build Steps') {
            parallel {
                stage('Get Git Change Log') {
                    steps {
                        script {
                            FAILED_STAGE = env.STAGE_NAME
                            def git = load 'scripts/common/git.groovy'
                            vars.GIT_CHANGELOG = git.getChangeLog(previousCommit: env.GIT_PREVIOUS_SUCCESSFUL_COMMIT, currentCommit: env.GIT_COMMIT)
                        }
                    }
                }
                stage('Docker Hub Login') {
                    steps {
                        script {
                            FAILED_STAGE = env.STAGE_NAME
                            def docker = load 'scripts/common/docker.groovy'
                            docker.dockerLogin(credentialsId: 'dockerhub_credentials')
                        }
                    }
                }
            }
        }
        stage('Build and Push Docker Image') {
            steps {
                script {
                    FAILED_STAGE = env.STAGE_NAME
                    def dockerUtil = load 'scripts/common/docker.groovy'
                    dockerUtil.buildAndPushDockerImage(
                        dockerfile: vars.DOCKERFILE_PATH,
                        image: vars.IMAGE_NAME,
                        tag: vars.CONTAINER_NAME,
                        repo: vars.DOCKER_HUB_REPO,
                        context: vars.BUILD_CONTEXT
                    )
                }
            }
        }
        stage('Deploy New Instance') {
            steps {
                script {
                    FAILED_STAGE = env.STAGE_NAME
                    def docker = load 'scripts/common/docker.groovy'
                    docker.deployNewInstance(
                        containerName: vars.CONTAINER_NAME,
                        image: vars.IMAGE_NAME,
                        imageTag: vars.IMAGE_TAG ?: vars.CONTAINER_NAME,
                        hostPort: vars.APP_PORT,
                        containerPort: "5000",
                        network: vars.APPLICATION_NETWORK,
                        restartPolicy: "always",
                        extraNetworks: [vars.INFRA_NETWORK]
                    )
                }
            }
        }
        stage('Health Check') {
            steps {
                script {
                    FAILED_STAGE = env.STAGE_NAME
                    def healthCheckUrl = "http://${vars.CONTAINER_NAME}:5000${vars.ACTUATOR_PATH}"
                    echo "Constructed Health Check URL: ${healthCheckUrl}"

                    def healthCheckUtil = load 'scripts/common/healthCheck.groovy'
                    healthCheckUtil.performHealthCheck(
                        healthCheckUrl: healthCheckUrl,
                        timeout: 60000,
                        deployContainer: vars.CONTAINER_NAME
                    )
                }
            }
        }
    }
    post {
        failure {
            script {
                def slackNotifier = load 'scripts/common/slackNotifier.groovy'
                slackNotifier.sendSlackBuildNotification(
                    message: ":scream_cat: Stage *${FAILED_STAGE}* failed.",
                    color: vars.SLACK_COLOR_FAILURE,
                    jobUrl: "${vars.JENKINS_DOMAIN}/job/${env.JOB_NAME}",
                    consoleOutputUrl: "${vars.JENKINS_DOMAIN}/job/${env.JOB_NAME}/${env.BUILD_NUMBER}/console",
                    slackUrl: vars.SLACK_WEBHOOK_URL,
                    changeLog: vars.GIT_CHANGELOG
                )
            }
        }
        success {
            script {
                def slackNotifier = load 'scripts/common/slackNotifier.groovy'
                slackNotifier.sendSlackBuildNotification(
                    message: ":rocket: Deployment completed successfully",
                    color: vars.SLACK_COLOR_SUCCESS,
                    jobUrl: "${vars.JENKINS_DOMAIN}/job/${env.JOB_NAME}",
                    consoleOutputUrl: "${vars.JENKINS_DOMAIN}/job/${env.JOB_NAME}/${env.BUILD_NUMBER}/console",
                    slackUrl: vars.SLACK_WEBHOOK_URL,
                    changeLog: vars.GIT_CHANGELOG
                )
            }
        }
    }
}
