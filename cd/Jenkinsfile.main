// cd/Jenkinsfile.main
pipeline {
    agent any

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Analyze Changes') {
            steps {
                script {
                    def analyzeChanges = load "${env.WORKSPACE}/cd/scripts/common/analyzeChanges.groovy"
                    def changedServices = analyzeChanges()
                    echo "Changed services: ${changedServices}"
                    env.CHANGED_SERVICES = changedServices.join(',')
                }
            }
        }
        stage('Trigger Sub-Pipelines') {
            steps {
                script {
                    def changed = env.CHANGED_SERVICES.split(',')

                    if (changed.contains('core')) {
                        echo "Triggering stempo-prod..."
                        build job: 'stempo-prod', propagate: true
                    }
                    if (changed.contains('rhythm')) {
                        echo "Triggering stempo-prod-rhythm..."
                        build job: 'stempo-prod-rhythm', propagate: true
                    }
                    if (!changed.contains('core') && !changed.contains('rhythm')) {
                        echo "No relevant service changes. Skipping sub-pipelines."
                    }
                }
            }
        }
    }
}
