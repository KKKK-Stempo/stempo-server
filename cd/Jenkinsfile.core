// cd/Jenkinsfile.core
def FAILED_STAGE = ""
def BACKUP_FILE = ""
def vars = [:]

pipeline {
    agent any

    stages {
        stage('Load Environment Variables') {
            steps {
                script {
                    FAILED_STAGE = env.STAGE_NAME
                }
                withCredentials([file(credentialsId: 'stempo_prod_core_config_yml', variable: 'CONFIG_FILE')]) {
                    script {
                        def envLoader = load 'cd/scripts/common/envLoader.groovy'
                        vars.WORKSPACE = env.WORKSPACE
                        def mappingTable = [
                            [yamlPath: "jenkins-domain", targetKey: "JENKINS_DOMAIN", required: true],
                            [yamlPath: "slack.webhook-url", targetKey: "SLACK_WEBHOOK_URL", required: true],
                            [yamlPath: "slack.color-success", targetKey: "SLACK_COLOR_SUCCESS", required: true],
                            [yamlPath: "slack.color-failure", targetKey: "SLACK_COLOR_FAILURE", required: true],

                            [yamlPath: "mariadb.user", targetKey: "MARIA_DB_USER", required: true],
                            [yamlPath: "mariadb.password", targetKey: "MARIA_DB_PASSWORD", required: true],
                            [yamlPath: "mariadb.backup-dir", targetKey: "BACKUP_DIR", required: true],

                            [yamlPath: "dockerhub.repo", targetKey: "DOCKER_HUB_REPO", required: true],

                            [yamlPath: "host.default-path", targetKey: "HOST_DEFAULT_PATH", required: true],
                            [yamlPath: "host.logs-path", targetKey: "HOST_LOGS_PATH", required: true],

                            [yamlPath: "container.default-path", targetKey: "CONTAINER_DEFAULT_PATH", required: true],
                            [yamlPath: "container.logs-path", targetKey: "CONTAINER_LOGS_PATH", required: true],

                            [yamlPath: "containers.blue", targetKey: "BLUE_CONTAINER", required: true],
                            [yamlPath: "containers.green", targetKey: "GREEN_CONTAINER", required: true],
                            [yamlPath: "containers.blue-url", targetKey: "BLUE_URL", required: true],
                            [yamlPath: "containers.green-url", targetKey: "GREEN_URL", required: true],
                            [yamlPath: "containers.image-name", targetKey: "IMAGE_NAME", required: true],

                            [yamlPath: "networks.application", targetKey: "APPLICATION_NETWORK", required: true],
                            [yamlPath: "networks.infra", targetKey: "INFRA_NETWORK", required: true],

                            [yamlPath: "spring.profile", targetKey: "PROFILE", required: true],
                            [yamlPath: "spring.port-a", targetKey: "PORT_A", required: true],
                            [yamlPath: "spring.port-b", targetKey: "PORT_B", required: true],

                            [yamlPath: "admin.username", targetKey: "WHITELIST_ADMIN_USERNAME", required: true],
                            [yamlPath: "admin.password", targetKey: "WHITELIST_ADMIN_PASSWORD", required: true],

                            [yamlPath: "docker.dockerfile-path", targetKey: "DOCKERFILE_PATH", required: true],
                            [yamlPath: "docker.nginx-container-name", targetKey: "NGINX_CONTAINER_NAME", required: true],
                            [yamlPath: "docker.mariadb-container-name", targetKey: "MARIA_DB_CONTAINER_NAME", required: true],
                            [yamlPath: "docker.nginx-config-path", targetKey: "NGINX_CONFIG_PATH", required: true],
                            [yamlPath: "docker.build-context", targetKey: "BUILD_CONTEXT", required: true],

                            [yamlPath: "healthcheck.actuator-path", targetKey: "ACTUATOR_PATH", required: true],

                            [yamlPath: "profile.resources-path", targetKey: "RESOURCES_PATH", required: true],
                            [yamlPath: "profile.file-name", targetKey: "PROFILE_FILE_NAME", required: true]
                        ]
                        envLoader.loadEnvironmentVariables(configFile: env.CONFIG_FILE, targetMap: vars, mappingTable: mappingTable)
                    }
                }
            }
        }
        stage('Configure Centralized Spring Profiles') {
            steps {
                script {
                    def framework = load 'cd/scripts/framework/spring.groovy'
                    framework.configureModuleProfile(credentialsId: 'stempo_prod_core_yml', resourcePath: vars.RESOURCES_PATH, profileFile: vars.PROFILE_FILE_NAME)
                }
            }
        }
        stage('Concurrent Pre-Build Steps') {
            parallel {
                stage('Get Git Change Log') {
                    steps {
                        script {
                            FAILED_STAGE = env.STAGE_NAME
                            def git = load 'cd/scripts/common/git.groovy'
                            vars.GIT_CHANGELOG = git.getChangeLog(previousCommit: env.GIT_PREVIOUS_SUCCESSFUL_COMMIT, currentCommit: env.GIT_COMMIT)
                        }
                    }
                }
                stage('MariaDB Backup') {
                    steps {
                        script {
                            FAILED_STAGE = env.STAGE_NAME
                            def dbBackup = load 'cd/scripts/common/db.groovy'
                            BACKUP_FILE = dbBackup.backupMariaDB(
                                dbUser: vars.MARIA_DB_USER,
                                dbPassword: vars.MARIA_DB_PASSWORD,
                                containerName: vars.MARIA_DB_CONTAINER_NAME,
                                backupDir: vars.BACKUP_DIR
                            )
                        }
                    }
                }
                stage('Docker Hub Login') {
                    steps {
                        script {
                            FAILED_STAGE = env.STAGE_NAME
                            def docker = load 'cd/scripts/common/docker.groovy'
                            docker.dockerLogin(credentialsId: 'dockerhub_credentials')
                        }
                    }
                }
                stage('Determine Containers') {
                    steps {
                        script {
                            FAILED_STAGE = env.STAGE_NAME
                            def deploymentBG = load 'cd/scripts/deployment/blueGreen.groovy'
                            deploymentBG.determineContainers(
                                blueContainer: vars.BLUE_CONTAINER,
                                greenContainer: vars.GREEN_CONTAINER,
                                blueUrl: vars.BLUE_URL,
                                greenUrl: vars.GREEN_URL,
                                portA: vars.PORT_A,
                                portB: vars.PORT_B,
                                targetMap: vars
                            )
                        }
                    }
                }
            }
        }
        stage('Build and Push Docker Image') {
            steps {
                script {
                    FAILED_STAGE = env.STAGE_NAME
                    def dockerUtil = load 'cd/scripts/common/docker.groovy'
                    dockerUtil.buildAndPushDockerImage(
                        dockerfile: vars.DOCKERFILE_PATH,
                        image: vars.IMAGE_NAME,
                        tag: vars.DEPLOY_CONTAINER,
                        repo: vars.DOCKER_HUB_REPO,
                        context: vars.BUILD_CONTEXT
                    )
                }
            }
        }
        stage('Deploy New Instance') {
            steps {
                script {
                    FAILED_STAGE = env.STAGE_NAME
                    def docker = load 'cd/scripts/common/docker.groovy'
                    docker.deployNewInstance(
                        containerName: vars.DEPLOY_CONTAINER,
                        image: vars.IMAGE_NAME,
                        imageTag: vars.IMAGE_TAG ?: vars.CONTAINER_NAME,
                        hostPort: vars.NEW_PORT,
                        containerPort: "8080",
                        network: vars.APPLICATION_NETWORK,
                        restartPolicy: "unless-stopped",
                        volumes: [
                            "${vars.HOST_DEFAULT_PATH}:${vars.CONTAINER_DEFAULT_PATH}",
                            "${vars.HOST_LOGS_PATH}:${vars.CONTAINER_LOGS_PATH}"
                        ],
                        envVars: [
                            "LOG_PATH=${vars.CONTAINER_LOGS_PATH}",
                            "SPRING_PROFILES_ACTIVE=${vars.PROFILE}"
                        ],
                        extraNetworks: [vars.INFRA_NETWORK]
                    )
                }
            }
        }
        stage('Health Check') {
            steps {
                script {
                    FAILED_STAGE = env.STAGE_NAME
                    def publicIp = sh(script: "curl -s ifconfig.me", returnStdout: true).trim()
                    def healthCheckUrl = "http://${publicIp}:${vars.NEW_PORT}${vars.ACTUATOR_PATH}"
                    echo "Constructed Health Check URL: ${healthCheckUrl}"

                    def healthCheckUtil = load 'cd/scripts/common/healthCheck.groovy'
                    healthCheckUtil.performHealthCheck(
                        healthCheckUrl: healthCheckUrl,
                        whitelistUsername: vars.WHITELIST_ADMIN_USERNAME,
                        whitelistPassword: vars.WHITELIST_ADMIN_PASSWORD,
                        timeout: 150000,
                        deployContainer: vars.DEPLOY_CONTAINER
                    )
                }
            }
        }
        stage('Switch Traffic and Cleanup') {
            steps {
                script {
                    FAILED_STAGE = env.STAGE_NAME
                    def nginx = load 'cd/scripts/common/nginx.groovy'
                    nginx.updateConfig(
                        container: vars.NGINX_CONTAINER_NAME,
                        targetUrl: vars.NEW_TARGET,
                        configFile: vars.NGINX_CONFIG_PATH,
                        oldPort: vars.OLD_PORT,
                        newPort: vars.NEW_PORT
                    )
                    nginx.reloadConfig(container: vars.NGINX_CONTAINER_NAME)
                }
                script {
                    def docker = load 'cd/scripts/common/docker.groovy'
                    docker.stopAndRemoveContainer(vars.CURRENT_CONTAINER)
                }
            }
        }
    }
    post {
        failure {
            script {
                def slackNotifier = load 'cd/scripts/common/slackNotifier.groovy'
                slackNotifier.sendSlackBuildNotification(
                    message: ":scream_cat: Stage *${FAILED_STAGE}* failed.",
                    color: vars.SLACK_COLOR_FAILURE,
                    jobUrl: "${vars.JENKINS_DOMAIN}/job/${env.JOB_NAME}",
                    consoleOutputUrl: "${vars.JENKINS_DOMAIN}/job/${env.JOB_NAME}/${env.BUILD_NUMBER}/console",
                    slackUrl: vars.SLACK_WEBHOOK_URL,
                    changeLog: vars.GIT_CHANGELOG
                )
            }
        }
        success {
            script {
                def slackNotifier = load 'cd/scripts/common/slackNotifier.groovy'
                slackNotifier.sendSlackBuildNotification(
                    message: ":rocket: Deployment completed successfully",
                    color: vars.SLACK_COLOR_SUCCESS,
                    jobUrl: "${vars.JENKINS_DOMAIN}/job/${env.JOB_NAME}",
                    consoleOutputUrl: "${vars.JENKINS_DOMAIN}/job/${env.JOB_NAME}/${env.BUILD_NUMBER}/console",
                    slackUrl: vars.SLACK_WEBHOOK_URL,
                    changeLog: vars.GIT_CHANGELOG
                )
            }
        }
    }
}
